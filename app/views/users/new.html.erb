<h1>New User</h1>

<%= form_with(model: @user, local: true) do |f| %>
  <div>
    <%= f.label :name, "Name" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :active, "Active" %>
    <%= f.check_box :active %>
  </div>

  <%= f.submit "Create User" %>
<% end %>