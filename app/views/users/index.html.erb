<h1>Users</h1>
<%= link_to 'New User', new_user_path %>

<table>
  <% @users.each do |user| %>
    <tr id="user_<%= user.id %>">
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td><%= link_to 'Show', user %></td>
      <td>
        <%= link_to 'Destroy', user, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
      </td>
    </tr>
  <% end %>
</table>